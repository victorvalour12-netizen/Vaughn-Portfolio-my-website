<!DOCTYPE html>
<html lang="en">
{{> partials/head}}

<body>
  {{> partials/nav}}

  <main class="blog-single-page">
    <article class="blog-single-article">
      
      <div class="blog-single-top">
        <a href="/blogs" class="back-link">← Back to Blogs</a>
        <span class="blog-single-cat">{{BLOG.category}}</span>
      </div>

      <header class="blog-single-header">
        <h1 class="blog-single-title">{{BLOG.blogName}}</h1>
        
        <div class="blog-single-meta-row">
          {{#BLOG.DATE}}
          <div class="author-line">
            <div class="author-avatar">H</div>
            <div>
              <span class="author-name">Harper</span>
              <time datetime="{{BLOG.date}}">{{date}} • 5 min read</time>
            </div>
          </div>
          {{/BLOG.DATE}}
          
          <div class="share-group">
            <a href="{{SHARE_WHATSAPP}}" target="_blank" class="share-btn wa">WA</a>
            <a href="{{SHARE_TWITTER}}" target="_blank" class="share-btn x">X</a>
            <a href="{{SHARE_FACEBOOK}}" target="_blank" class="share-btn fb">FB</a>
          </div>
        </div>

        <div class="blog-single-cover">
          <img src="{{BLOG.blogImage}}" alt="{{BLOG.blogName}}">
        </div>
      </header>

      <div class="blog-single-content">
        {{{BLOG.blogContent}}}
      </div>

      <footer class="blog-single-footer">
        <div class="tags">
          <span class="tag">#{{BLOG.category}}</span>
        </div>
        <p>Share this story</p>
        <div class="share-group large">
            <a href="{{SHARE_WHATSAPP}}" target="_blank" class="share-btn wa">WhatsApp</a>
            <a href="{{SHARE_TWITTER}}" target="_blank" class="share-btn x">Twitter</a>
            <a href="{{SHARE_FACEBOOK}}" target="_blank" class="share-btn fb">Facebook</a>
        </div>
      </footer>

    </article>

    <!-- READ MORE POV -->
    {{#POV}}
    <section class="related-section">
      <h2>Read more</h2>
      <div class="related-grid">
        {{#POV}}
          <a href="/blogs/{{slug}}" class="related-card">
            <h3>Read the {{character}}'s POV →</h3>
          </a>
        {{/POV}}
      </div>
    </section>
    {{/POV}}

    <!-- RELATED -->
    <section class="related-section">
      <h2>More from {{BLOG.category}}</h2>
      <div class="related-grid blog-related-grid">
        {{#RELATED}}
          <a href="/blogs/{{slug}}" class="related-card blog-related">
            <div class="related-img" style="background-image: url('{{blogImage}}')"></div>
            <p>{{blogName}}</p>
            <small>{{category}} • {{date}}</small>
          </a>
        {{/RELATED}}
      </div>
    </section>

  </main>

  {{> partials/more}}
  {{> partials/float}}
  {{> partials/footer}}
</body>
</html>