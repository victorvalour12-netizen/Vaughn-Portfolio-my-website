    {{#DEALSPAGE}}
    <section id="deals" class="page">
      <h2 id="view">All Deals</h2>
      <p style="color: var(--text-muted);">Every Tech Deal You May Need!</p>

      <div class="category-filter">
        {{#CATEGORIES}}
        <a href="/deals?category={{slug}}" hx-get="/deals?category={{slug}}" hx-target="#deals-content"
          hx-swap="innerHTML" hx-push-url="true" class="category-btn {{#active}}active{{/active}}">
          <span>{{icon}}</span> {{name}}
        </a>
        {{/CATEGORIES}}
      </div>

      <div id="deals-content"> <!-- HTMX will swap this -->
        <div class="projects-grid" id="deals-container">
          {{#DEALS}}
          <div class="project-card">
            <img src="{{dealImage}}" alt="{{dealName}}" loading="lazy">
            <div class="project-content">
              <h3>{{dealName}}</h3>
              <div class="tags">
                {{#TOOL}}
                <span class="tag">{{name}}</span>
                {{/TOOL}}
              </div>
              <p>₦{{price}}</p>
              <p>{{dealDescription}}</p>
              <a href="/deals/{{slug}}" class="view-project">View Deal →</a>
            </div>
          </div>
          {{/DEALS}}
        </div>

        <div id="loader" class="loader" style="display:none; text-align:center; padding:2rem;">Loading more deals...
        </div>
        <div id="end-message" style="display:none; text-align:center; padding:2rem;">No more deals 🎉</div>
      </div>
    </section>

    {{> partials/find}}
    {{/DEALSPAGE}}

    <script>
      let currentPage = 1;
      let loading = false;
      let hasMore = {{ hasMore }};
      let currentCategory = "{{currentCategory}}";

      const container = document.getElementById('deals-container');
      const loader = document.getElementById('loader');
      const endMessage = document.getElementById('end-message');

      function renderDeal(deal) {
        let tools = '';
        if (deal.TOOL) {
          tools = deal.TOOL.map(t => `<span class="tag">${t.name}</span>`).join('');
        }
        return `
    <div class="project-card">
      <img src="${deal.dealImage}" alt="${deal.dealName}" loading="lazy">
      <div class="project-content">
        <h3>${deal.dealName}</h3>
        <div class="tags">${tools}</div>
        <p>₦${Number(deal.price).toLocaleString()}</p>
        <p>${deal.dealDescription}</p>
        <a href="/deals/${deal.slug}" class="view-project">View Deal →</a>
      </div>
    </div>
  `;
      }

      async function loadDeals() {
        if (loading || !hasMore) return;
        loading = true;
        loader.style.display = 'block';

        try {
          const res = await fetch(`/api/deals?page=${currentPage + 1}&category=${currentCategory}`);
          const data = await res.json();

          data.DEALS.forEach(deal => {
            container.insertAdjacentHTML('beforeend', renderDeal(deal));
          });

          hasMore = data.hasMore;
          currentPage++;

          if (!hasMore) {
            loader.style.display = 'none';
            endMessage.style.display = 'block';
            window.removeEventListener('scroll', handleScroll);
          }
        } catch (err) {
          console.error(err);
        }

        loading = false;
        loader.style.display = 'none';
      }

      function handleScroll() {
        const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
        if (scrollTop + clientHeight >= scrollHeight - 300) {
          loadDeals();
        }
      }

      // Reset when category changes via HTMX
      document.body.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === "deals-content") {
          currentPage = 1;
          hasMore = true;
          window.addEventListener('scroll', handleScroll);
        }
      });

      window.addEventListener('scroll', handleScroll);
    </script>


